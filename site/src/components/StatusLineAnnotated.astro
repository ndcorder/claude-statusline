---
import StatusLine from './StatusLine.astro';
---

<div class="annotated-wrapper">
  <StatusLine />
  <pre class="annotations" aria-hidden="true">
<span class="a-ptr">↑         ↑           ↑                       ↑                     ↑                ↑                ↑</span>
<span class="a-lbl">user      cwd         model                   git                   context          cost             duration</span>

<span class="a-ptr">  ↑                  ↑                             ↑              ↑          ↑          ↑                       ↑           ↑                     ↑</span>
<span class="a-lbl">  tokens             cache                         savings        sparkline  runway     rate limits             diff        api                   vs avg</span></pre>
</div>

<style>
  .annotated-wrapper {
    position: relative;
  }

  .annotations {
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    font-size: 12.5px;
    line-height: 1.5;
    color: #abb2bf;
    overflow-x: auto;
  }

  .a-ptr {
    opacity: 0.15;
  }

  .a-lbl {
    opacity: 0.25;
    font-size: 10.5px;
  }
</style>
